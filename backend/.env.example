# ─────────────────────────────────────────────────────────────────────────────
# SP Platform — Environment Variables Template
# 1. Copy:   cp .env.example .env
# 2. Fill in real values below
# 3. NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# ── SQL Server ────────────────────────────────────────────────────────────────
# Policy: min 8 chars, uppercase + lowercase + digit + special char
SA_PASSWORD=
DB_NAME=SPDb
DB_CONNECTION_STRING=Server=database,1433;Database=SP;User Id=sa;Password=YourSaPasswordHere!;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED — minimum 32 characters, use a cryptographically random secret in production
JWT_SECRET=
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_DAYS=7

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production, e.g. https://app.example.com
# Leave empty to allow all origins (development only)
CORS_ORIGIN_0=

# ── App ───────────────────────────────────────────────────────────────────────
# Public base URL of the API (used in password reset links, etc.)
APP_BASE_URL=
APP_DEFAULT_AVATAR_URL=https://ui-avatars.com/api/?background=random

# ── Seeder credentials (only used when Seeder:Enabled=true) ──────────────────
SEEDER_ADMIN_EMAIL=
SEEDER_ADMIN_PASSWORD=
SEEDER_PROVIDER_EMAIL=
SEEDER_PROVIDER_PASSWORD=
SEEDER_CLIENT_EMAIL=
SEEDER_CLIENT_PASSWORD=

# ── Logging ───────────────────────────────────────────────────────────────────
# Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=Information
LOG_FILE_PATH=logs/sp-.log

# ── Chargily ──────────────────────────────────────────────────────────────────
CHARGILY_SECRET_KEY=
CHARGILY_BASE_URL=https://pay.chargily.net/test/api/v2
CHARGILY_WEBHOOK_SECRET=
CHARGILY_SUCCESS_URL=http://localhost:5293/payments/success
CHARGILY_FAILURE_URL=http://localhost:5293/payments/failure
CHARGILY_ALLOW_TEST_MODE=true

